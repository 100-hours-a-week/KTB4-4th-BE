# Database
DB_USERNAME=
DB_PASSWORD=

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_DATABASE=0
SPRING_DATA_REDIS_USERNAME=
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_CONNECT_TIMEOUT=1s
SPRING_DATA_REDIS_TIMEOUT=1s

# Kakao OAuth
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/api/v1/auth/kakao/callback
KAKAO_FRIEND_REDIRECT_URI=http://localhost:8080/api/v1/friends/kakao/callback
KAKAO_ADMIN_KEY=
KAKAO_TOKEN_ENCRYPTION_KEY=

# Authentication
JWT_SECRET=
AUTH_COOKIE_SECURE=false

# 외부 평가용 테스트 계정 로그인 (POST /api/v1/auth/demo/login)
# 선택 (미설정 시 꺼짐). 평가 기간에만 켠다.
# - 이 파일은 Spring이 .properties로 읽는다. 계정은 아래 프로퍼티 이름으로 적고 값은 따옴표로 감싸지 않는다.
#   (배포 환경의 OS 환경변수로 넣을 때는 AUTH_DEMOLOGIN_ACCOUNTS_0_LOGINID 형식을 쓴다)
# - 비밀번호 원문은 넣지 않는다. 해시 생성: htpasswd -bnBC 10 "" '비밀번호' | tr -d ':\n'
# - user-id는 db/manual/seed-demo-accounts.sql 실행 결과의 user_id
# - 계정 항목을 일부만 채우면 기동에 실패한다. 계정마다 세 값을 모두 채운다.
# DEMO_LOGIN_ENABLED=false
# auth.demo-login.accounts[0].login-id=
# auth.demo-login.accounts[0].password-hash=
# auth.demo-login.accounts[0].user-id=
# 계정을 더 넣으려면 [1], [2] ... 로 이어서 적는다.

# AI Server
AI_SERVER_BASE_URL=http://localhost:9000
AI_SERVICE_TOKEN=
# 선택 (미설정 시 기본값 사용)
# AI_SERVER_CONNECT_TIMEOUT=3s
# AI_SERVER_READ_TIMEOUT=30s

# AI Chat
# 선택 (미설정 시 기본값 사용)
# AI_CHAT_PENDING_TIMEOUT=1m
# AI_CHAT_COMPLETION_COOLDOWN=24h
# AI_CHAT_SHORT_COOLDOWN_EXTERNAL_IDS=123456789,987654321
# AI_CHAT_SHORT_COMPLETION_COOLDOWN=5m
# AI_CHAT_SESSION_IDLE_TIMEOUT=30m
# AI_CHAT_SESSION_MAX_DURATION=2h
# AI_CHAT_SESSION_EXPIRY_MARGIN=1m

# Web Push Notification
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# 선택 (미설정 시 기본값 사용)
# WEB_PUSH_TTL=24h
# WEB_PUSH_REQUEST_TIMEOUT=5s

# Actuator
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,prometheus

# User
# 선택 (미설정 시 기본값 사용)
# USER_WITHDRAWAL_LOCK_TTL=120s
